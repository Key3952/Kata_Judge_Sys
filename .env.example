# .env.example - Шаблон конфигурации приложения
# Скопируйте в .env и измените значения для production

# ==================== БЕЗОПАСНОСТЬ ====================
# Секретный ключ Flask (минимум 32 символа, используйте openssl rand -hex 32)
FLASK_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
# Пароль администратора (измените в production!)
ADMIN_PASSWORD=admin123
# Cookie настройки
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# ==================== ЛОГИРОВАНИЕ ====================
LOG_LEVEL=INFO
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==================== ПРИЛОЖЕНИЕ ====================
FLASK_ENV=development
FLASK_DEBUG=True
MAX_CONTENT_LENGTH=16777216

# ==================== SOCKET.IO ====================
SOCKETIO_CORS_ORIGINS=*
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_PING_TIMEOUT=60
SOCKETIO_PING_INTERVAL=25

# ==================== КЕШИРОВАНИЕ ====================
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ==================== RATE LIMITING ====================
RATELIMIT_ENABLED=False
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URL=memory://
